{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Piper File",
            "type": "shell",
            "command": "cargo",
            "args": [
                "run",
                "--manifest-path",
                "${workspaceFolder}/Cargo.toml",
                "--",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Piper REPL",
            "type": "shell",
            "command": "cargo",
            "args": [
                "run",
                "--manifest-path",
                "${workspaceFolder}/Cargo.toml"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
