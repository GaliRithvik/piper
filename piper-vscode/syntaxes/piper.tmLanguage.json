{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Piper",
  "scopeName": "source.piper",
  "fileTypes": ["piper"],
  "patterns": [
    { "include": "#triple_fstring" },
    { "include": "#triple_string" },
    { "include": "#fstring" },
    { "include": "#string" },
    { "include": "#comment" },
    { "include": "#function_def" },
    { "include": "#class_def" },
    { "include": "#keyword_control" },
    { "include": "#keyword_storage" },
    { "include": "#constant_language" },
    { "include": "#function_call" },
    { "include": "#number" },
    { "include": "#operator" }
  ],
  "repository": {

    "comment": {
      "name": "comment.line.number-sign.piper",
      "match": "#.*$"
    },

    "triple_fstring": {
      "name": "string.quoted.triple.piper",
      "begin": "f\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "name": "meta.interpolation.piper",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "#keyword_control" }, { "include": "#number" }]
        },
        { "name": "constant.character.escape.piper", "match": "\\\\." }
      ]
    },

    "triple_string": {
      "name": "string.quoted.triple.piper",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        { "name": "constant.character.escape.piper", "match": "\\\\." }
      ]
    },

    "fstring": {
      "name": "string.quoted.double.piper",
      "begin": "f\"",
      "end": "\"",
      "patterns": [
        {
          "name": "meta.interpolation.piper",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "#keyword_control" }, { "include": "#number" }]
        },
        { "name": "constant.character.escape.piper", "match": "\\\\." }
      ]
    },

    "string": {
      "name": "string.quoted.double.piper",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.piper", "match": "\\\\." }
      ]
    },

    "function_def": {
      "comment": "fn keyword + function name — must come before keyword_storage",
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.piper" },
        "2": { "name": "entity.name.function.piper" }
      }
    },

    "class_def": {
      "comment": "class keyword + class name — must come before keyword_storage",
      "match": "\\b(class)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.class.piper" },
        "2": { "name": "entity.name.class.piper" }
      }
    },

    "keyword_control": {
      "name": "keyword.control.piper",
      "match": "\\b(if|elif|else|for|while|break|continue|return|in|and|or|not)\\b"
    },

    "keyword_storage": {
      "comment": "fn and class handled by function_def/class_def above",
      "patterns": [
        {
          "name": "storage.type.piper",
          "match": "\\b(let)\\b"
        },
        {
          "name": "storage.modifier.piper",
          "match": "\\b(static|super)\\b"
        },
        {
          "name": "keyword.control.import.piper",
          "match": "\\b(import|from)\\b"
        }
      ]
    },

    "constant_language": {
      "name": "constant.language.piper",
      "match": "\\b(true|false|none)\\b"
    },

    "function_call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.piper" }
      }
    },

    "number": {
      "name": "constant.numeric.piper",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },

    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.piper",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.null-safe.piper",
          "match": "\\?\\?|\\?\\."
        },
        {
          "name": "keyword.operator.arrow.piper",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.comparison.piper",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.piper",
          "match": "\\+=|-=|\\*\\*=|\\*=|//=|/=|%=|="
        },
        {
          "name": "keyword.operator.arithmetic.piper",
          "match": "\\*\\*|//|[+\\-*/%]"
        }
      ]
    }
  }
}
