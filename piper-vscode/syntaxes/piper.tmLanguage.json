{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Piper",
  "scopeName": "source.piper",
  "fileTypes": ["piper"],
  "patterns": [
    { "include": "#triple_fstring" },
    { "include": "#triple_string" },
    { "include": "#fstring" },
    { "include": "#string" },
    { "include": "#comment" },
    { "include": "#keyword_control" },
    { "include": "#keyword_declaration" },
    { "include": "#keyword_operator" },
    { "include": "#constant_language" },
    { "include": "#function_def" },
    { "include": "#class_def" },
    { "include": "#function_call" },
    { "include": "#number" },
    { "include": "#operator" },
    { "include": "#pipe" },
    { "include": "#null_safe" }
  ],
  "repository": {

    "comment": {
      "name": "comment.line.number-sign.piper",
      "match": "#.*$"
    },

    "triple_fstring": {
      "name": "string.quoted.triple.fstring.piper",
      "begin": "f\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "name": "meta.interpolation.piper",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "$self" }]
        },
        { "name": "constant.character.escape.piper", "match": "\\\\." }
      ]
    },

    "triple_string": {
      "name": "string.quoted.triple.piper",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        { "name": "constant.character.escape.piper", "match": "\\\\." }
      ]
    },

    "fstring": {
      "name": "string.quoted.double.fstring.piper",
      "begin": "f\"",
      "end": "\"",
      "patterns": [
        {
          "name": "meta.interpolation.piper",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "$self" }]
        },
        { "name": "constant.character.escape.piper", "match": "\\\\." }
      ]
    },

    "string": {
      "name": "string.quoted.double.piper",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.piper", "match": "\\\\." }
      ]
    },

    "keyword_control": {
      "name": "keyword.control.piper",
      "match": "\\b(if|elif|else|for|while|break|continue|return|in|and|or|not)\\b"
    },

    "keyword_declaration": {
      "name": "keyword.declaration.piper",
      "match": "\\b(fn|let|class|static|super|import|from)\\b"
    },

    "keyword_operator": {
      "name": "keyword.operator.word.piper",
      "match": "\\b(and|or|not|in)\\b"
    },

    "constant_language": {
      "name": "constant.language.piper",
      "match": "\\b(true|false|none)\\b"
    },

    "function_def": {
      "match": "(?<=\\bfn\\s{1,20})([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.function.piper" }
      }
    },

    "class_def": {
      "match": "(?<=\\bclass\\s{1,20})([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.class.piper" }
      }
    },

    "function_call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.piper" }
      }
    },

    "number": {
      "name": "constant.numeric.piper",
      "match": "\\b([0-9]+\\.?[0-9]*)\\b"
    },

    "operator": {
      "name": "keyword.operator.piper",
      "match": "(==|!=|<=|>=|<|>|\\+=|-=|\\*=|/=|//=|%=|\\*\\*=|=|\\+|-|\\*\\*|\\*|//|/|%|->|=>)"
    },

    "pipe": {
      "name": "keyword.operator.pipe.piper",
      "match": "\\|>"
    },

    "null_safe": {
      "name": "keyword.operator.null-safe.piper",
      "match": "(\\?\\?|\\?\\.)"
    }
  }
}
