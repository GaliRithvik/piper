{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Piper",
    "scopeName": "source.piper",
    "patterns": [
        { "include": "#comment" },
        { "include": "#fstring" },
        { "include": "#string" },
        { "include": "#keyword" },
        { "include": "#builtin" },
        { "include": "#constant" },
        { "include": "#number" },
        { "include": "#operator" },
        { "include": "#function-def" },
        { "include": "#function-call" }
    ],
    "repository": {
        "comment": {
            "name": "comment.line.number-sign.piper",
            "match": "#.*$"
        },
        "fstring": {
            "name": "string.interpolated.piper",
            "begin": "f[\"']",
            "end": "[\"']",
            "patterns": [
                {
                    "name": "punctuation.definition.template-expression.piper",
                    "begin": "\\{",
                    "end": "\\}",
                    "patterns": [{ "include": "$self" }]
                },
                {
                    "name": "constant.character.escape.piper",
                    "match": "\\\\."
                }
            ]
        },
        "string": {
            "patterns": [
                {
                    "name": "string.quoted.double.piper",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [{ "name": "constant.character.escape.piper", "match": "\\\\." }]
                },
                {
                    "name": "string.quoted.single.piper",
                    "begin": "'",
                    "end": "'",
                    "patterns": [{ "name": "constant.character.escape.piper", "match": "\\\\." }]
                }
            ]
        },
        "keyword": {
            "patterns": [
                {
                    "name": "keyword.control.piper",
                    "match": "\\b(if|elif|else|for|while|in|break|continue|try|except|return)\\b"
                },
                {
                    "name": "keyword.declaration.piper",
                    "match": "\\b(let|fn)\\b"
                },
                {
                    "name": "keyword.operator.logical.piper",
                    "match": "\\b(and|or|not)\\b"
                }
            ]
        },
        "constant": {
            "patterns": [
                {
                    "name": "constant.language.piper",
                    "match": "\\b(true|false|none|null|nil)\\b"
                },
                {
                    "name": "constant.language.numeric.piper",
                    "match": "\\b(pi|e|inf|nan)\\b"
                }
            ]
        },
        "builtin": {
            "name": "support.function.builtin.piper",
            "match": "\\b(print|input|str|int|float|bool|type|abs|sqrt|cbrt|pow|exp|log|log2|log10|sin|cos|tan|asin|acos|atan|atan2|floor|ceil|round|sign|clamp|relu|leaky_relu|sigmoid|tanh|softmax|gelu|selu|dot|vadd|vsub|vmul|vdiv|vscale|norm|normalize|cross|matmul|transpose|identity|reshape|sum|mean|std|stdev|variance|min|max|argmax|argmin|median|len|range|append|pop|sort|reverse|slice|flatten|zip|map|filter|reduce|enumerate|zeros|ones|linspace|arange|upper|lower|trim|split|join|contains|replace|startswith|endswith|char|keys|values|items|has_key|get|del_key|mse|cross_entropy|one_hot)\\b"
        },
        "number": {
            "name": "constant.numeric.piper",
            "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        },
        "operator": {
            "patterns": [
                {
                    "name": "keyword.operator.pipe.piper",
                    "match": "\\|>"
                },
                {
                    "name": "keyword.operator.arithmetic.piper",
                    "match": "\\*\\*|[+\\-*/%]"
                },
                {
                    "name": "keyword.operator.comparison.piper",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.assignment.piper",
                    "match": "\\+=|-=|\\*=|/=|="
                }
            ]
        },
        "function-def": {
            "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
            "captures": {
                "1": { "name": "keyword.declaration.piper" },
                "2": { "name": "entity.name.function.piper" }
            }
        },
        "function-call": {
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
            "captures": {
                "1": { "name": "entity.name.function.call.piper" }
            }
        }
    }
}
